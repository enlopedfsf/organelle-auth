/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    enlopedfsf/organelleauth Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // TODO nf-core: Specify your pipeline's command line flags
    // Input options
    input                      = null

    // Canonical local run layout. The fixed launcher and the defaults below keep all
    // ordinary runs in one place, regardless of the shell's current working directory.
    // A user may still provide an explicit --input/--outdir for an intentional isolated run.
    run_root                   = "${projectDir}/runs"
    input_dir                  = "${projectDir}/runs/input"

    // References
    genome                     = null
    igenomes_base              = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore            = false

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = "${projectDir}/runs/output"
    work_dir                    = "${projectDir}/runs/work"
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    // Stable report names make the canonical report location predictable. Provenance is
    // retained in params.json, trace metadata, and the Nextflow run history.
    trace_report_suffix          = 'latest'

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true

    // ---- M1-① plant short-read assembly knobs (total plan §9.3 param classification) ----
    // fastp Q/length thresholds are NOT a param here — they live ONLY in
    // conf/experimental.config (process.withName:FASTP.ext.args), so they can never leak
    // into a production default (ENG-POL-001).
    // coverage_valley_coefficient: scientific acceptance threshold (总方案 §3.5 "局部深度 <
    // 全序列中位数 × 系数"). Policy-injected (policy pack thresholds.short_read_qc). null in
    // experimental → ASSEMBLY_QC annotates depth only, makes NO valley call (SCI-005/ENG-POL-002).
    coverage_valley_coefficient = null

    // ---- M1-② identify knobs (decision thresholds come FROM the policy/reference pack, never
    // hardcoded in code — SCI-001 / ENG-POL). These params only locate the asset files. ----
    // Directory holding per-id reference pack subdirectories (manifest.json + FASTA + TSVs).
    reference_pack_dir = "${projectDir}/assets/reference_packs"
    // Path to the loaded policy pack JSON for this run (per-profile). null/missing → DECISION_ENGINE
    // treats all thresholds as null → INCONCLUSIVE + [THRESHOLD_NOT_CONFIGURED] (决策 2, no crash).
    policy_pack_file = null
    // M2-② SCI-007: typed nuclear-marker interface. The supplied v0.1 asset is deliberately
    // EMPTY_PLACEHOLDER; it records absence and never fabricates an ITS2 fallback.
    animal_marker_interface_file = "${projectDir}/assets/marker_interfaces/animal-sci-007-empty.json"

    // ---- M2-① animal branch asset locations (tool-level resources, NOT scientific thresholds) ----
    // Multi-reference mitochondrial bait set (bundled; design 决策 3 — it enriches reads, does NOT
    // decide; the ② reference pack is the decision asset). Multi-reference avoids single-reference
    // D-loop dropout (方法学 §4.3).
    animal_bait_reference_fasta = "${projectDir}/assets/bait_references/mitofinder-bait-v0.1/multi_ref.fasta"
    // Single GenBank reference for MitoFinder annotation (conspecific where available).
    animal_annotation_reference_gb = "${projectDir}/assets/bait_references/mitofinder-bait-v0.1/NC_023928.gb"
    // ---- NUMT risk-screen thresholds (policy-injected, ENG-POL-001/002). null in experimental ->
    // the screen ALWAYS writes a metrics report but emits no NUMT_RISK_SUSPECTED signal (design 决策 6). ----
    numt_coverage_coefficient = null   // depth valley < median × coeff
    numt_multimap_fraction    = null   // secondary-alignment fraction above which a signal fires

    // ---- M3 plant long-read pilot (EXPERIMENTAL; never enters IDENTIFY/DECISION) ----
    long_read_pilot_reference_fasta = "${projectDir}/assets/reference_packs/corydalis-test-0.1/PZ405204_plastome.fasta"
    long_read_pilot_manifest = "${projectDir}/assets/long_read_pilot/plant-corydalis-ont-v0.1/manifest.json"
    long_read_pilot_reference_metadata = "${projectDir}/assets/long_read_pilot/plant-corydalis-ont-v0.1/reference-metadata.json"
    // M1 evidence anchor is a required explicit input for structural comparison. It is not
    // silently replaced by the reference; real/test profiles must supply a verified non-empty FASTA.
    long_read_pilot_m1_anchor_fasta = null
    // Default points to the all-null production policy. The experimental profile is the ONLY
    // place that selects concrete exploratory recruitment/gate values (ENG-POL-001/002).
    long_read_reference_first_policy_file = "${projectDir}/assets/policies/plant-long-read-reference-first/production-v0.1.json"
    long_read_filter_policy_file = null
    minimap2_container = 'community.wave.seqera.io/library/minimap2_samtools:b09096fc890429ce'
    flye_container = 'community.wave.seqera.io/library/flye:2.9.5--d577924c8416ccd8'
    // No validated PMAT2 image exists yet. Use a runnable shell image so the optional comparator
    // emits structured COMPARATOR_ASSEMBLY_FAILED evidence instead of failing at container launch;
    // callers may override this only with a verified PMAT2 image.
    pmat2_container = 'docker.io/library/python:3.12'
}

// Nextflow task scratch is fixed independently of the launch directory.
workDir = params.work_dir

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    ci_test   { includeConfig 'conf/ci_test.config'   }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
    // M1-①: experimental profile injects unvalidated thresholds (fastp Q/length) and
    // selects the experimental policy pack. production must NOT load this — ENG-POL-001/003.
    experimental { includeConfig 'conf/experimental.config' }
    // M1-②: engineering-test profile loads the UNCALIBRATED engineering-test policy so the
    // identify decision LOGIC can be exercised. Production MUST NOT load this — ENG-POL-002.
    engineering_test { includeConfig 'conf/engineering_test.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load enlopedfsf/organelleauth custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load enlopedfsf/organelleauth custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/organelleauth.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Load igenomes.config if required
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'enlopedfsf/organelleauth'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'enlopedfsf',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/enlopedfsf/organelle-auth'
    description     = """TCM organelle genome authentication system"""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.10.4'
    version         = '0.1.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
