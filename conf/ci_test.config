/*
 * Resource ceiling for nf-test on GitHub-hosted runners.
 *
 * This profile is CI-only: it keeps unit/module tests below the 2 vCPU / 7.8 GB
 * capacity exposed to Docker by ubuntu-latest. Production profiles retain the
 * resource requirements in conf/base.config.
 */
process {
    resourceLimits = [
        cpus: 2,
        memory: '7.GB',
        time: '1.h'
    ]

    cpus = 1
    memory = '2.GB'

    withLabel:process_low {
        cpus = 1
        memory = '2.GB'
    }
    withLabel:process_medium {
        cpus = 2
        memory = '4.GB'
    }
    withLabel:process_high {
        cpus = 2
        memory = '6.GB'
    }
    withLabel:process_high_memory {
        memory = '6.GB'
    }
    withName:MITOFINDER {
        cpus = 2
        memory = '6.GB'
    }
}
