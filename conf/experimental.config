/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    enlopedfsf/organelleauth experimental profile (M1-①)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Injects UNVALIDATED scientific thresholds and selects the experimental policy pack.
    Per ENG-POL-001/002/003 (总方案 §9.1):
      - The fastp Q/length values below MUST NOT appear in any production default.
      - production profile MUST NOT load this file.
      - Output is marked experimental (policy_pack_id = tcm-plant-experimental-0.1.0).
    This is the ONLY place concrete fastp Q/length thresholds are supplied; production reads
    them from an approved, validated policy pack (still null today).
----------------------------------------------------------------------------------------
*/

params {

    config_profile_name        = 'Experimental (M1-①, unvalidated thresholds)'
    config_profile_description = 'Plant short-read assembly + read-back evidence with EXPERIMENTAL, unvalidated thresholds. NOT for production.'

    // Coverage-valley coefficient stays null in experimental (policy pack
    // tcm-plant-experimental-0.1.0 has thresholds.short_read_qc = null). ASSEMBLY_QC
    // therefore annotates depth only and makes no valley call (SCI-005). Explicitly null
    // here for clarity; do NOT set a number — that would be a hardcoded scientific threshold.
    coverage_valley_coefficient = null
}

process {

    // fastp Q/length thresholds — 方法学 §2.1 参考参数 (qualified_quality_phred 15,
    // length_required 50). ENG-POL-001: unvalidated QC thresholds; they live ONLY in this
    // experimental profile, never in production. In any other profile FASTP ext.args is
    // unset → the module defaults to '' → no Q/length filtering. (--detect_adapter_for_pe
    // is built into the nf-core fastp PE branch, not a tunable threshold.)
    withName: FASTP {
        ext.args = '--qualified_quality_phred 15 --length_required 50'
    }
}
