/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    enlopedfsf/organelleauth engineering-test profile (M1-②)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Loads the UNCALIBRATED engineering-test policy pack (decision thresholds = measured
    placeholders from the Corydalis ① run) so the identify decision LOGIC can be exercised
    end-to-end. Per design 决策 4 / ENG-POL-002:
      - The thresholds are placeholders, NOT calibrated science (M3 experiments + M5 policy v1.0).
      - Production MUST NOT load this profile.
    Builds on the experimental profile (fastp Q/length, coverage_valley_coefficient=null).
----------------------------------------------------------------------------------------
*/

includeConfig 'experimental.config'

params {

    config_profile_name        = 'Engineering test (M1-②, uncalibrated thresholds)'
    config_profile_description = 'Plant short-read IDENTIFY with an UNCALIBRATED engineering-test policy. Logic-validation ONLY; NOT for production.'

    // Path to the engineering-test policy JSON (callable_site + uncertainty_zone filled with
    // uncalibrated placeholders). DECISION_ENGINE reads thresholds from here.
    policy_pack_file = "${projectDir}/policies/tcm-plant-engineering-test.json"
}
