/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // Lean M0: no analysis modules wired yet (fastqc/multiqc demo removed).
    // Per-module ext.args / publishDir overrides will be added as modules are
    // introduced in M1+ via OpenSpec changes.

    // ---- M1-① GetOrganelle (nf-core getorganelle/fromreads, aliased per target) ----
    // -R (word coverage) / -k (k-mer) are GetOrganelle ALGORITHM parameters (总方案 §9.3),
    // NOT scientific acceptance thresholds → frozen here, identical in ALL profiles
    // (experimental and production). fastp/coverage thresholds, by contrast, are policy-
    // gated (experimental.config / policy pack). See design.md 决策 2 + 决策 4-附.
    withName: GETORGANELLE_FROMREADS_PT {
        // 方法学 §3.1 逐字;亦为 GetOrganelle 官方 README embplant_pt 配方
        // (Kinggerm/GetOrganelle README: -R 15 -k 21,45,65,85,105 -F embplant_pt).
        ext.args = '-R 15 -k 21,45,65,85,105'
    }
    withName: GETORGANELLE_FROMREADS_NR {
        // 方法学 §3.2 逐字. -k 35,85,115 = GetOrganelle 官方 README embplant_nr 配方
        // (Kinggerm/GetOrganelle README: -k 35,85,115 -F embplant_nr; README 示例另带 -R 10,
        // 方法学对 nrDNA 不设 -R,此处照方法学逐字,不加 -R).
        ext.args = '-k 35,85,115'
    }

    // ---- M1-① ASSEMBLY_QC read-back: clean reads 回贴组装 (方法学 §3.5/§3.6) ----
    // -x sr = minimap2 短读长预设. bam_format=true 在 ASSEMBLY_QC 子流程调用处传入,
    // 模块内置 samtools sort 直接产出 sorted BAM (接口合同 readback/<sample>.sorted.bam).
    withName: MINIMAP2_ALIGN {
        ext.args = '-x sr'
    }

    // ---- M1-① EMIT_ASSEMBLY_QC_STATUS: stage the contract tree (BUG #4 fix) ----
    // The emitter builds the contract tree (plant_sr_assembly/<sid>/...) INSIDE its work dir
    // and never writes to params.outdir directly. This override replaces the global publishDir
    // (which would land files under ${params.outdir}/emit/) and mirrors the work-dir tree to
    // ${params.outdir}/ root, reproducing the exact ①→② contract layout (design.md §1). Copy
    // mode avoids container/host UID permission errors on the host outdir.
    withName: EMIT_ASSEMBLY_QC_STATUS {
        publishDir = [
            path: { params.outdir },
            mode: 'copy',
            overwrite: true
        ]
    }

    // ---- M1-② EMIT_IDENTIFY_STATUS: mirror the identify contract tree to ${params.outdir} ----
    // Same BUG #4 pattern as ①'s emitter: the status JSON + staged evidence are built inside the
    // work dir (container-owned) and mirrored to ${params.outdir}/plant_sr_assembly/<sid>/ (copy
    // mode avoids container/host UID permission errors). The identify status lands at
    // ${params.outdir}/plant_sr_assembly/<sid>/<sid>.identify.status.json, alongside ①'s evidence.
    withName: EMIT_IDENTIFY_STATUS {
        publishDir = [
            path: { params.outdir },
            mode: 'copy',
            overwrite: true
        ]
    }

}
