{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/enlopedfsf/organelle-auth/assets/schema_status.json",
    "title": "organelle-auth per-sample status object (总方案 §5.5)",
    "description": "每个关键 subworkflow 输出的机器可读状态。pipeline failure 与 scientific INCONCLUSIVE 分开编码。",
    "type": "object",
    "required": ["sample_id", "stage", "status", "reason_codes", "policy_pack_id"],
    "properties": {
        "sample_id": { "type": "string" },
        "stage": { "type": "string" },
        "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL", "INCONCLUSIVE"] },
        "assembly_grade": {
            "type": ["string", "null"],
            "enum": ["REFERENCE", "DRAFT", "CANDIDATE", "NOT_APPLICABLE", null]
        },
        "decision": {
            "type": ["string", "null"],
            "enum": ["AUTHENTIC", "NON_AUTHENTIC", "INCONCLUSIVE", "NOT_APPLICABLE", null]
        },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "policy_pack_id": { "type": "string" },
        "nuclear_marker": {
            "type": ["object", "null"],
            "description": "SCI-007 marker-panel interface state; absent evidence is explicit and is never replaced with an inferred ITS2 result.",
            "properties": {
                "interface_id": { "type": ["string", "null"] },
                "version": { "type": ["string", "null"] },
                "panel_status": { "type": ["string", "null"] },
                "state": {
                    "type": ["string", "null"],
                    "enum": ["NOT_APPLICABLE", "PRESENT", "MISSING", "UNCALLABLE", "MISMATCH", null]
                },
                "reason_code": { "type": ["string", "null"] },
                "required_for_decision": { "type": ["boolean", "null"] }
            }
        },
        "evidence_files": { "type": "array", "items": { "type": "string" } }
    }
}
