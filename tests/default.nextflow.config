// Scope Nextflow's stub mode to the full-pipeline smoke tests in default.nf.test.
stubRun = true

// Stub scripts need only POSIX shell utilities. Pin the M3 evaluation processes to a small,
// stable test image so CI does not pull scientific-tool images that are never invoked in stub
// mode. Production and non-stub container selections remain defined in nextflow.config.
process {
    withName: /.*(LR_|FLYE_|PMAT2_SUBSET_COMPARATOR).*/ {
        container = 'community.wave.seqera.io/library/fastp:1.3.6--4df8d6c11b471bde'
    }
}
