nextflow_process {

    name "Test Process DECISION_ENGINE"
    script "../main.nf"
    process "DECISION_ENGINE"
    tag "modules_local"
    tag "decision_engine"

    // 决策 1 gating matrix + 决策 2 null defense. policy_file is a path(staged file) so it is visible
    // inside the docker container (a host-path val is NOT mounted — BUG fixed after the scenario-1
    // real run). The other path inputs are staged as files. Decision is read from decision.json.
    //
    // Staged inputs use `${projectDir}/x.json` (nf-test's projectDir == repo root == the cwd that the
    // setup `new File('x')` writes to), so setup-write and input-stage always agree. This is the
    // cwd-independent pattern from the nf-test docs. See ② design 决策 1/2.

    test("DRAFT + all diagnostic callable + high identity -> AUTHENTIC + WARN [INCOMPLETE_ASSEMBLY]") {
        setup {
            new File('asm.json').bytes = '{"status":"WARN","assembly_grade":"DRAFT","reason_codes":["NO_CIRCULARIZATION"]}'.bytes
            new File('cm.json').bytes  = '{"callable_coverage":0.99,"mean_readback_depth":500.0}'.bytes
            new File('dm.json').bytes  = '{"n_diagnostic_total":5,"n_diagnostic_callable":5,"diagnostic_identity":0.9995,"uncallable_sites":[]}'.bytes
            new File('man.json').bytes = '{"conflict_rules":{"non_authentic_identity":0.90}}'.bytes
            new File('policy.json').bytes = '{"policy_id":"tcm-plant-engineering-test-0.1.0","status":"experimental","thresholds":{"callable_site":{"min_callable_fraction":0.90,"min_mean_depth":20},"uncertainty_zone":{"lower":0.90,"upper":0.99}}}'.bytes
        }
        when {
            process {
                """
                input[0] = [ [id:'S1'], 'DRAFT', true, file("${projectDir}/asm.json"), file("${projectDir}/cm.json"), file("${projectDir}/dm.json"), file("${projectDir}/man.json") ]
                input[1] = file("${projectDir}/policy.json")
                """
            }
        }
        then {
            assert process.success
            def d = new groovy.json.JsonSlurper().parseText(path(process.out.decision.get(0).get(1)).text)
            assert d.decision == 'AUTHENTIC'
            assert d.status == 'WARN'
            assert d.reason_codes == ['INCOMPLETE_ASSEMBLY']
        }
    }

    test("diagnostic sites not callable -> INCONCLUSIVE + [DIAGNOSTIC_SITES_NOT_CALLABLE]") {
        setup {
            new File('asm.json').bytes = '{"status":"WARN","assembly_grade":"DRAFT","reason_codes":["NO_CIRCULARIZATION"]}'.bytes
            new File('cm.json').bytes  = '{"callable_coverage":0.99,"mean_readback_depth":500.0}'.bytes
            new File('dm.json').bytes  = '{"n_diagnostic_total":5,"n_diagnostic_callable":3,"diagnostic_identity":0.999,"uncallable_sites":["ds4","ds5"]}'.bytes
            new File('man.json').bytes = '{"conflict_rules":{"non_authentic_identity":0.90}}'.bytes
            new File('policy.json').bytes = '{"policy_id":"p","status":"experimental","thresholds":{"callable_site":{"min_callable_fraction":0.90,"min_mean_depth":20},"uncertainty_zone":{"lower":0.90,"upper":0.99}}}'.bytes
        }
        when {
            process {
                """
                input[0] = [ [id:'S1'], 'DRAFT', true, file("${projectDir}/asm.json"), file("${projectDir}/cm.json"), file("${projectDir}/dm.json"), file("${projectDir}/man.json") ]
                input[1] = file("${projectDir}/policy.json")
                """
            }
        }
        then {
            assert process.success
            def d = new groovy.json.JsonSlurper().parseText(path(process.out.decision.get(0).get(1)).text)
            assert d.decision == 'INCONCLUSIVE'
            assert d.reason_codes == ['DIAGNOSTIC_SITES_NOT_CALLABLE']
        }
    }

    test("null policy threshold -> INCONCLUSIVE + [THRESHOLD_NOT_CONFIGURED] (决策 2, no crash)") {
        setup {
            new File('asm.json').bytes = '{"status":"WARN","assembly_grade":"DRAFT","reason_codes":["NO_CIRCULARIZATION"]}'.bytes
            new File('cm.json').bytes  = '{"callable_coverage":0.99,"mean_readback_depth":500.0}'.bytes
            new File('dm.json').bytes  = '{"n_diagnostic_total":5,"n_diagnostic_callable":5,"diagnostic_identity":0.9995,"uncallable_sites":[]}'.bytes
            new File('man.json').bytes = '{"conflict_rules":{"non_authentic_identity":0.90}}'.bytes
            new File('policy.json').bytes = '{"policy_id":"fixture-all-null","status":"production","thresholds":{"callable_site":null,"uncertainty_zone":null}}'.bytes
        }
        when {
            process {
                """
                input[0] = [ [id:'S1'], 'DRAFT', true, file("${projectDir}/asm.json"), file("${projectDir}/cm.json"), file("${projectDir}/dm.json"), file("${projectDir}/man.json") ]
                input[1] = file("${projectDir}/policy.json")
                """
            }
        }
        then {
            assert process.success            // 决策 2: null threshold does NOT crash
            def d = new groovy.json.JsonSlurper().parseText(path(process.out.decision.get(0).get(1)).text)
            assert d.decision == 'INCONCLUSIVE'
            assert d.reason_codes == ['THRESHOLD_NOT_CONFIGURED']
        }
    }

    test("identity below conflict threshold -> NON_AUTHENTIC + [IDENTITY_BELOW_THRESHOLD]") {
        setup {
            new File('asm.json').bytes = '{"status":"PASS","assembly_grade":"CANDIDATE","reason_codes":[]}'.bytes
            new File('cm.json').bytes  = '{"callable_coverage":0.99,"mean_readback_depth":500.0}'.bytes
            new File('dm.json').bytes  = '{"n_diagnostic_total":5,"n_diagnostic_callable":5,"diagnostic_identity":0.80,"uncallable_sites":[]}'.bytes
            new File('man.json').bytes = '{"conflict_rules":{"non_authentic_identity":0.90}}'.bytes
            new File('policy.json').bytes = '{"policy_id":"p","status":"experimental","thresholds":{"callable_site":{"min_callable_fraction":0.90,"min_mean_depth":20},"uncertainty_zone":{"lower":0.90,"upper":0.99}}}'.bytes
        }
        when {
            process {
                """
                input[0] = [ [id:'S1'], 'CANDIDATE', true, file("${projectDir}/asm.json"), file("${projectDir}/cm.json"), file("${projectDir}/dm.json"), file("${projectDir}/man.json") ]
                input[1] = file("${projectDir}/policy.json")
                """
            }
        }
        then {
            assert process.success
            def d = new groovy.json.JsonSlurper().parseText(path(process.out.decision.get(0).get(1)).text)
            assert d.decision == 'NON_AUTHENTIC'
            assert d.reason_codes == ['IDENTITY_BELOW_THRESHOLD']
        }
    }

    test("① FAIL -> passthrough INCONCLUSIVE (透传 ① reason)") {
        setup {
            new File('asm.json').bytes = '{"status":"FAIL","assembly_grade":"NOT_APPLICABLE","reason_codes":["ASSEMBLY_FAILED"]}'.bytes
            new File('cm.json').bytes  = '{"callable_coverage":0.0,"mean_readback_depth":0.0}'.bytes
            new File('dm.json').bytes  = '{"n_diagnostic_total":5,"n_diagnostic_callable":0,"diagnostic_identity":null,"uncallable_sites":["ds1","ds2","ds3","ds4","ds5"]}'.bytes
            new File('man.json').bytes = '{"conflict_rules":{"non_authentic_identity":0.90}}'.bytes
            new File('policy.json').bytes = '{"policy_id":"p","status":"experimental","thresholds":{"callable_site":{"min_callable_fraction":0.90,"min_mean_depth":20},"uncertainty_zone":{"lower":0.90,"upper":0.99}}}'.bytes
        }
        when {
            process {
                """
                input[0] = [ [id:'S1'], 'NOT_APPLICABLE', false, file("${projectDir}/asm.json"), file("${projectDir}/cm.json"), file("${projectDir}/dm.json"), file("${projectDir}/man.json") ]
                input[1] = file("${projectDir}/policy.json")
                """
            }
        }
        then {
            assert process.success
            def d = new groovy.json.JsonSlurper().parseText(path(process.out.decision.get(0).get(1)).text)
            assert d.decision == 'INCONCLUSIVE'
            assert d.reason_codes == ['ASSEMBLY_FAILED']     // 透传 ① reason
        }
    }

    test("callable coverage below threshold -> INCONCLUSIVE + [LOW_CALLABLE_COVERAGE]") {
        setup {
            new File('asm.json').bytes = '{"status":"WARN","assembly_grade":"DRAFT","reason_codes":["NO_CIRCULARIZATION"]}'.bytes
            new File('cm.json').bytes  = '{"callable_coverage":0.85,"mean_readback_depth":500.0}'.bytes
            new File('dm.json').bytes  = '{"n_diagnostic_total":5,"n_diagnostic_callable":5,"diagnostic_identity":0.9995,"uncallable_sites":[]}'.bytes
            new File('man.json').bytes = '{"conflict_rules":{"non_authentic_identity":0.90}}'.bytes
            new File('policy.json').bytes = '{"policy_id":"p","status":"experimental","thresholds":{"callable_site":{"min_callable_fraction":0.90,"min_mean_depth":20},"uncertainty_zone":{"lower":0.90,"upper":0.99}}}'.bytes
        }
        when {
            process {
                """
                input[0] = [ [id:'S1'], 'DRAFT', true, file("${projectDir}/asm.json"), file("${projectDir}/cm.json"), file("${projectDir}/dm.json"), file("${projectDir}/man.json") ]
                input[1] = file("${projectDir}/policy.json")
                """
            }
        }
        then {
            assert process.success
            def d = new groovy.json.JsonSlurper().parseText(path(process.out.decision.get(0).get(1)).text)
            assert d.decision == 'INCONCLUSIVE'
            assert d.reason_codes == ['LOW_CALLABLE_COVERAGE']
        }
    }

    test("mean readback depth below threshold -> INCONCLUSIVE + [LOW_SEQUENCING_DEPTH]") {
        setup {
            new File('asm.json').bytes = '{"status":"WARN","assembly_grade":"DRAFT","reason_codes":["NO_CIRCULARIZATION"]}'.bytes
            new File('cm.json').bytes  = '{"callable_coverage":0.99,"mean_readback_depth":10.0}'.bytes
            new File('dm.json').bytes  = '{"n_diagnostic_total":5,"n_diagnostic_callable":5,"diagnostic_identity":0.9995,"uncallable_sites":[]}'.bytes
            new File('man.json').bytes = '{"conflict_rules":{"non_authentic_identity":0.90}}'.bytes
            new File('policy.json').bytes = '{"policy_id":"p","status":"experimental","thresholds":{"callable_site":{"min_callable_fraction":0.90,"min_mean_depth":20},"uncertainty_zone":{"lower":0.90,"upper":0.99}}}'.bytes
        }
        when {
            process {
                """
                input[0] = [ [id:'S1'], 'DRAFT', true, file("${projectDir}/asm.json"), file("${projectDir}/cm.json"), file("${projectDir}/dm.json"), file("${projectDir}/man.json") ]
                input[1] = file("${projectDir}/policy.json")
                """
            }
        }
        then {
            assert process.success
            def d = new groovy.json.JsonSlurper().parseText(path(process.out.decision.get(0).get(1)).text)
            assert d.decision == 'INCONCLUSIVE'
            assert d.reason_codes == ['LOW_SEQUENCING_DEPTH']
        }
    }
}
